{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "web in node for vite & playwright",
  "compilerOptions": {
    "composite": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "vite.config.*",
    "playwright.config.*",
    "pwa-assets.config.*",
    "scripts/cleave-retry.ts"
  ]
}
