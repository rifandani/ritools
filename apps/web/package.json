{
  "name": "@workspace/web",
  "version": "0.0.1",
  "private": true,
  "description": "A browser-based MMO collectible/trading-card strategy game",
  "license": "MIT",
  "author": "Tri Rizeki Rifandani",
  "type": "module",
  "scripts": {
    "sitemap:gen": "bun scripts/gen-sitemap.ts",
    "pwa-assets:gen": "pwa-assets-generator",
    "typecheck": "tsc --noEmit",
    "typerange": "fr",
    "typerange:audit": "fr --audit",
    "test:install": "playwright install --with-deps chromium",
    "test:report": "playwright show-report",
    "test": "bun --env-file=.env.local run playwright test",
    "test:ui": "bun --env-file=.env.local run playwright test --ui --headed",
    "test:ci": "bun --env-file=.env.local run playwright test --forbid-only",
    "test:unit": "vitest run --project web",
    "check-site-meta": "bunx check-site-meta 3001 -p 3051",
    "dev": "portless run --name web.heynbord vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "build-and-preview": "bun run --sequential build preview"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.0",
    "@effect/platform-browser": "4.0.0",
    "@internationalized/date": "3.12.4",
    "@reactuses/core": "6.5.9",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "cn": "0.4.0",
    "effect": "4.0.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "motion": "13.5.0",
    "react": "19.3.0",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "react-stately": "3.50.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-variants": "3.3.1",
    "tw-animate-css": "1.4.0",
    "type-fest": "5.10.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-plugin": "1.168.42",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "1.0.4",
    "@vitejs/plugin-react": "6.1.1",
    "@workspace/typescript-config": "workspace:*",
    "agentation": "3.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "nitro": "3.0.260903-beta",
    "rollup-plugin-visualizer": "7.1.1",
    "sitemap": "9.0.1",
    "tailwindcss": "4.3.3",
    "tailwindcss-react-aria-components": "2.2.0",
    "vite": "8.3.2",
    "vite-plugin-pwa": "1.3.0",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  }
}
