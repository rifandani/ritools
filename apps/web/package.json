{
  "name": "@workspace/web",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "author": "Tri Rizeki Rifandani",
  "type": "module",
  "scripts": {
    "sitemap:gen": "bun scripts/gen-sitemap.ts",
    "brand:gen": "bun scripts/generate-brand-assets.ts",
    "brand:shots": "bun scripts/capture-pwa-screenshots.ts",
    "typecheck": "tsc --noEmit",
    "typerange": "fr",
    "typerange:audit": "fr --audit",
    "test:install": "playwright install --with-deps chromium",
    "test:report": "playwright show-report",
    "test": "bun --env-file=.env.local run playwright test",
    "test:ui": "bun --env-file=.env.local run playwright test --ui --headed",
    "test:ci": "bun --env-file=.env.local run playwright test --forbid-only",
    "test:unit": "vitest run --project web",
    "check-site-meta": "bunx check-site-meta 3001 -p 3051",
    "dev": "bun scripts/copy-resvg-wasm.ts && bun scripts/copy-ocr-assets.ts && portless run --name web.ritools vite dev",
    "build": "bun scripts/copy-resvg-wasm.ts && bun scripts/copy-ocr-assets.ts && vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "build-and-preview": "bun run --sequential build preview",
    "build:worker": "bun scripts/copy-resvg-wasm.ts && bun scripts/copy-ocr-assets.ts && NITRO_PRESET=cloudflare-module vite build"
  },
  "dependencies": {
    "@colorhythm/exiftool-wasm": "1.0.4",
    "@effect/atom-react": "4.0.0",
    "@effect/platform-browser": "4.0.0",
    "@embedpdf/engine-runtime": "3.0.0-next.18",
    "@embedpdf/engine-runtime-wasm32": "3.0.0-next.18",
    "@embedpdf/viewer-react": "3.0.0-next.18",
    "@internationalized/date": "3.12.4",
    "@jsquash/avif": "2.1.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/oxipng": "2.3.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/webp": "1.5.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@reactuses/core": "6.5.9",
    "@resvg/resvg-wasm": "2.6.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/ind": "1.0.0",
    "@xmldom/xmldom": "0.9.12",
    "client-zip": "2.5.1",
    "cn": "0.4.0",
    "effect": "4.0.0",
    "embla-carousel-react": "8.6.0",
    "etiket": "1.0.0",
    "fflate": "0.8.3",
    "input-otp": "1.5.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "motion": "13.5.0",
    "papaparse": "5.7.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-data-grid": "7.0.0-beta.63",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "react-stately": "3.50.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-variants": "3.3.1",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "tw-animate-css": "1.4.0",
    "type-fest": "5.10.0",
    "workbox-window": "7.4.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-plugin": "1.168.48",
    "@types/node": "26.6.3",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "1.0.4",
    "@vitejs/plugin-react": "6.1.1",
    "@workspace/typescript-config": "workspace:*",
    "babel-plugin-react-compiler": "1.0.0",
    "nitro": "3.0.260903-beta",
    "opentype.js": "2.0.0",
    "rollup-plugin-visualizer": "7.1.1",
    "sitemap": "9.0.1",
    "tailwindcss": "4.3.3",
    "tailwindcss-react-aria-components": "2.2.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "1.3.0",
    "woff2-encoder": "3.0.0-beta.1",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  }
}
