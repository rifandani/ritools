{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["src/index.{ts,tsx,js,jsx}", "src/main.{ts,tsx,js,jsx}"],
  "workspaces": {
    "patterns": ["apps/*", "packages/*"]
  },
  "ignoreExports": [
    { "file": "apps/web/**/components/ui/**", "exports": ["*"] },
    {
      "file": "vitest.msw.ts",
      "exports": ["*"]
    },
    {
      "file": "apps/web/src/master-design/**",
      "exports": ["*"]
    }
  ],
  "ignorePatterns": ["repos/**"],
  "dynamicallyLoaded": ["scripts/oxlint-plugins/**/*.ts"],
  "overrides": [
    {
      "files": ["apps/web/**/components/ui/**"],
      "rules": {
        "unused-files": "off",
        "unused-types": "off"
      }
    },
    {
      "files": [
        "apps/web/pwa-assets.config.ts",
        "apps/web/scripts/**",
        "apps/web/src/sw.ts",
        "apps/web/src/core/hooks/**",
        "oxfmt.config.ts",
        "oxlint.config.ts",
        "stryker.config.mjs",
        "scripts/security/**",
        "vitest.msw-setup.ts"
      ],
      "rules": {
        "unused-files": "off"
      }
    }
  ],
  "ignoreFindings": [
    "apps/web/src/routeTree.gen.ts",
    "apps/web/src/routes/__root.tsx"
  ],
  "duplicates": {
    "minOccurrences": 3,
    "ignore": []
  },
  "health": {
    "coverage": "coverage/vitest/coverage-final.json",
    "ignore": [
      "oxlint.config.ts",
      "**/pwa-assets.config.ts",
      "**/routeTree.gen.ts",
      "**/*.gen.ts",
      "**/components/ui/**",
      "apps/web/src/master-design/**",
      "**/*.{test,spec}.{ts,tsx}",
      "**/e2e/**",
      "scripts/security/**"
    ],
    "thresholdOverrides": [
      {
        "files": [
          "apps/web/src/features/expose/expose.c2pa.ts",
          "apps/web/src/features/expose/expose.payload.ts",
          "apps/web/src/features/expose/expose.reader.ts",
          "apps/web/src/features/expose/expose.groups.ts",
          "apps/web/src/features/expose/expose.ts"
        ],
        "maxCyclomatic": 60,
        "maxCognitive": 90,
        "maxCrap": 400,
        "reason": "Byte-level container parsers mirror the JPEG, PNG, TIFF, WebP, GIF, JUMBF, and CBOR specifications. Their branch count is format shape, not product branching; the reader and writer fixtures are the acceptance."
      },
      {
        "files": [
          "apps/web/src/features/expose/expose.writer.browser.ts",
          "apps/web/src/features/expose/expose.writer.node.ts"
        ],
        "maxCyclomatic": 20,
        "maxCognitive": 25,
        "maxCrap": 60,
        "reason": "The writer ports translate one clean request into ExifTool arguments and errors. Their branching follows the tool's argument surface."
      },
      {
        "files": ["apps/web/src/features/expose/use-expose.ts"],
        "maxCyclomatic": 20,
        "maxCognitive": 30,
        "maxCrap": 60,
        "reason": "The session hook maps the named engine states to one page state. Splitting the state table across hooks would spread one switch across files."
      },
      {
        "files": ["apps/web/src/features/expose/components/expose-*.tsx"],
        "maxCyclomatic": 20,
        "maxCognitive": 30,
        "maxCrap": 60,
        "reason": "The desk components print the report, the locator, the order, and the receipt from one report shape. Their cognitive load is the printed state table."
      }
    ]
  },
  "ignoreDependencies": [
    "@stryker-mutator/core",
    "@stryker-mutator/vitest-runner",
    "msw",
    "postcss-load-config",
    "workbox-core",
    "babel-plugin-react-compiler"
  ]
}
